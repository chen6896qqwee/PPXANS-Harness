{
  "agent": {
    "name": "皮皮虾",
    "yuan": "ppx",
    "max_tool_rounds": 8,
    "tool_result_budget": 4000,
    "max_tool_error_retry": 2,
    "workspace_prompt_mode": "absolute",
    "proactive": {
      "enabled": true,
      "interval_ms": 3600000
    },
    "evolve": {
      "enabled": true,
      "every_calls": 20,
      "min_interval_ms": 30000
    },
    "self_iteration": {
      "mode": "propose",
      "max_files": 3,
      "max_attempts": 2,
      "max_llm_calls": 6,
      "test_timeout_ms": 60000,
      "allow_test_edit": false
    },
    "self_code": {
      "mode": "propose",
      "syntax_timeout_ms": 5000,
      "test_timeout_ms": 120000
    },
    "evolution_loop": {
      "_note": "持续进化循环默认关闭 (Daily self-evolution loop is OFF by default)。设 enabled:true 后每天 03:30 自动跑「弱点学习→代码迭代→度量落账」; 手动单轮: npm run evolve:loop",
      "enabled": false,
      "cron": "03:30",
      "weakness_threshold": 3,
      "min_interval_ms": 60000
    }
  },
  "user": {
    "name": "用户"
  },
  "providers": [
    {
      "id": "openai",
      "base_url": "https://api.openai.com/v1",
      "api_key_env": "OPENAI_API_KEY",
      "model": "gpt-4o-mini",
      "timeout_ms": 180000,
      "context_window": 128000
    },
    {
      "id": "deepseek",
      "base_url": "https://api.deepseek.com/v1",
      "api_key_env": "DEEPSEEK_API_KEY",
      "model": "deepseek-chat",
      "timeout_ms": 180000,
      "context_window": 65536
    },
    {
      "id": "dashscope",
      "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
      "api_key_env": "DASHSCOPE_API_KEY",
      "model": "qwen-turbo",
      "timeout_ms": 180000,
      "context_window": 131072
    },
    {
      "id": "qwen-vl",
      "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
      "api_key_env": "DASHSCOPE_API_KEY",
      "model": "qwen-vl-max",
      "vision": true,
      "timeout_ms": 180000,
      "context_window": 32768
    },
    {
      "id": "lmstudio",
      "base_url": "http://127.0.0.1:1234/v1",
      "api_key": "lm-studio",
      "_note": "本地模型段: 先启动 LM Studio / Ollama, 再把 model 改成本地实际模型名 (Local model: start LM Studio/Ollama first, then set model to your actual local model name; no real key needed)",
      "model": "YOUR_LOCAL_MODEL_NAME",
      "vision": false,
      "timeout_ms": 180000
    },
    {
      "id": "zhipu",
      "base_url": "https://open.bigmodel.cn/api/paas/v4",
      "api_key_env": "ZHIPU_API_KEY",
      "model": "glm-4v-flash",
      "vision": true,
      "timeout_ms": 180000,
      "context_window": 65536
    }
  ],
  "memory": {
    "enabled": true,
    "token_budget": 2500,
    "decay_per_day": 0.02,
    "hit_bonus": 5,
    "base_importance": 10,
    "compile_threshold": 4.5,
    "forget_speed": 1,
    "memory_ttl_days": 90
  },
  "audit": {
    "enabled": true,
    "_note": "工具调用审计哈希链。append-only + SHA-256 链式防篡改, 落 data/logs/audit.ndjson。设 false 可关闭 (性能敏感场景)。校验: ppx 对话里调 audit_verify 工具, 或 npm run audit:verify。"
  },
  "embedding": {
    "base_url": "http://127.0.0.1:1234/v1",
    "api_key": "lm-studio",
    "model": "text-embedding-nomic-embed-text-v1.5"
  },
  "experience": {
    "enabled": true
  },
  "selfheal": {
    "enabled": true,
    "check_interval_ms": 60000
  },
  "tools": {
    "enabled": true
  },
  "channels": {
    "http": {
      "enabled": true,
      "port": 8899,
      "auth_token": ""
    },
    "log": {
      "enabled": true,
      "target": "console"
    },
    "feishu": {
      "enabled": false,
      "appId": "",
      "appSecret": "",
      "verifyToken": ""
    },
    "wechat": {
      "enabled": false,
      "path": "/wechat/webhook",
      "token": "",
      "encodingAESKey": "",
      "corpId": "",
      "corpSecret": "",
      "agentId": ""
    }
  },
  "security": {
    "allow_all": false,
    "command_timeout_ms": 30000,
    "deny": []
  },
  "hooks": {
    "trust_project_roots": [],
    "PreToolUse": [
      { "matcher": "run_command",
        "hooks": [ { "type": "command", "command": "node scripts/my-guard.js", "timeout": 10 } ] }
    ]
  }
}
