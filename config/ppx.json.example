{
  "agent": {
    "name": "皮皮虾",
    "yuan": "ppx",
    "max_tool_rounds": 8,
    "tool_result_budget": 4000,
    "max_tool_error_retry": 2,
    "_turn_projection_note": "v3.1 Turn 生命周期投影 (chat/turn/* 事件), 设 false 可旁路",
    "turn_projection": true,
    "_approval_note": "审批链路默认值 (与 src/agent/index.js / src/plugin/v3.js 兜底一致): headless_wait=false = 无 Web UI/serve 在听时立即拒绝, 不再死等 120s",
    "approval_mode": "on-request",
    "approval_timeout_ms": 120000,
    "approval_cache": true,
    "approval_headless_wait": false,
    "_cache_note": "health_cache_ms=provider 健康探测 TTL (0=关); stats_cache_ms=/api/stats 聚合 TTL (0=关)",
    "health_cache_ms": 30000,
    "stats_cache_ms": 2000,
    "_policy_note": "工具循环阈值: explore_break_limit=连续只读无产出 N 轮熔断; repeat_flag_limit=同工具+args 重复告警; parallel_tool_calls=false 回退串行",
    "explore_break_limit": 3,
    "repeat_flag_limit": 2,
    "parallel_tool_calls": true,
    "proactive": {
      "enabled": true,
      "interval_ms": 3600000
    },
    "evolve": {
      "enabled": true,
      "every_calls": 20,
      "min_interval_ms": 30000,
      "upgrade_uses": 3
    },
    "_legion_note": "子智能体并发治理 (v3.2.3)。max_concurrent_agents 是**进程级**硬上限: 嵌套委派 (子 agent 再派子 agent) 共享同一份配额, 不随层级翻倍。运行期可用 legion_set_concurrency 工具调整, 用 legion_status 观测。",
    "legion": {
      "default_size": 2,
      "max_concurrent_agents": 8,
      "max_concurrent_per_call": 4,
      "queue_timeout_ms": 300000,
      "delegate_timeout_ms": 120000,
      "kill_on_finish": true
    },
    "_boundary_note": "能力边界与人类监督 (v3.2.3)。六条硬边界 (幻觉/权限/隐私/法律伦理/成本/物理世界) 常驻 system; high_risk_domains 命中的任务会追加'只给分析不做决定 + 写明复核人'的动态护栏。require_human_review=false 只去掉话术, 不影响只读专家。",
    "boundary": {
      "enabled": true,
      "high_risk_domains": ["medical", "legal", "finance", "security", "compliance"],
      "require_human_review": true,
      "extra_limits": []
    }
  },
  "_skills_note": "技能库 (v3.2.3)。多源装配, 顺序即优先级: builtin (随包 skills/) → user_dir → project_dir → extra_dirs。同 id 先到先得。目录即分类: skills/<domain>/<skill>/SKILL.md (max_depth=2); 扁平 skills/<skill>/ 继续可用。新技能落盘到第一个可写根。",
  "skills": {
    "builtin": true,
    "user_dir": "~/.ppx/skills",
    "project_dir": "",
    "extra_dirs": [],
    "max_depth": 2,
    "prompt_hot_shown": 8,
    "prompt_desc_cap": 120
  },
  "_experts_note": "专家库 (v3.2.4 吸收 TencentCloud/Octop)。专家 = experts/<id>/{manifest.json, SOUL.md} 目录包 (可选 AGENTS.md), 启动扫描建册 —— 加一个专家 = 加一个目录。顺序即优先级: builtin → user_dir → project_dir → extra_dirs。expert_pack_install 装的第三方包落 user_dir, 升级不动内置库。",
  "experts": {
    "builtin": true,
    "user_dir": "~/.ppx/experts",
    "project_dir": "",
    "extra_dirs": []
  },
  "user": {
    "name": "用户"
  },
  "providers": [
    {
      "id": "openai",
      "base_url": "https://api.openai.com/v1",
      "api_key_env": "OPENAI_API_KEY",
      "model": "gpt-4o-mini",
      "timeout_ms": 180000,
      "context_window": 128000
    },
    {
      "id": "deepseek",
      "base_url": "https://api.deepseek.com/v1",
      "api_key_env": "DEEPSEEK_API_KEY",
      "model": "deepseek-chat",
      "timeout_ms": 180000,
      "context_window": 65536
    },
    {
      "id": "dashscope",
      "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
      "api_key_env": "DASHSCOPE_API_KEY",
      "model": "qwen-turbo",
      "timeout_ms": 180000,
      "context_window": 131072
    },
    {
      "id": "qwen-vl",
      "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
      "api_key_env": "DASHSCOPE_API_KEY",
      "model": "qwen-vl-max",
      "vision": true,
      "timeout_ms": 180000,
      "context_window": 32768
    },
    {
      "id": "lmstudio",
      "base_url": "http://127.0.0.1:1234/v1",
      "api_key": "lm-studio",
      "model": "YOUR_LOCAL_MODEL_NAME",
      "vision": false,
      "timeout_ms": 180000
    },
    {
      "id": "zhipu",
      "base_url": "https://open.bigmodel.cn/api/paas/v4",
      "api_key_env": "ZHIPU_API_KEY",
      "model": "glm-4v-flash",
      "vision": true,
      "timeout_ms": 180000,
      "context_window": 65536
    }
  ],
  "memory": {
    "decay_per_day": 0.02,
    "hit_bonus": 5,
    "base_importance": 10,
    "forget_speed": 1,
    "ttl_days": 90
  },
  "audit": {
    "enabled": true,
    "_note": "工具调用审计哈希链。append-only + SHA-256 链式防篡改, 落 data/logs/audit.ndjson。设 false 可关闭 (性能敏感场景)。校验: ppx 对话里调 audit_verify 工具, 或 npm run audit:verify。"
  },
  "embedding": {
    "_note": "语义检索向量化。backend=cloud: OpenAI 兼容端点 (如下方 LM Studio 本地服务); backend=local: transformers.js 本地模型 (需 npm i @huggingface/transformers, 离线可用, 默认 Xenova/multilingual-e5-small)。不配则纯 BM25 检索。",
    "backend": "cloud",
    "base_url": "http://127.0.0.1:1234/v1",
    "api_key": "lm-studio",
    "model": "text-embedding-nomic-embed-text-v1.5"
  },
  "voice": {
    "_note": "语音能力。asr=语音转文本: backend=cloud 走 OpenAI 兼容 /audio/transcriptions; backend=local 走本地 whisper (需 npm i nodejs-whisper, Windows 需 MinGW)。tts=文本转语音, 走 OpenAI 兼容 /audio/speech。",
    "enabled": true,
    "asr": { "backend": "cloud", "base_url": "http://127.0.0.1:1234/v1", "api_key": "lm-studio", "model": "whisper-1" },
    "tts": { "base_url": "http://127.0.0.1:1234/v1", "api_key": "lm-studio", "model": "tts-1", "voice": "alloy" }
  },
  "experience": {
    "enabled": true
  },
  "selfheal": {
    "enabled": true,
    "check_interval_ms": 60000
  },
  "tools": {
    "enabled": true
  },
  "channels": {
    "http": {
      "enabled": true,
      "port": 8899,
      "auth_token": ""
    },
    "log": {
      "enabled": true,
      "target": "console"
    },
    "feishu": {
      "enabled": false,
      "appId": "",
      "appSecret": "",
      "verifyToken": ""
    },
    "wechat": {
      "enabled": false,
      "path": "/wechat/webhook",
      "token": "",
      "encodingAESKey": "",
      "corpId": "",
      "corpSecret": "",
      "agentId": ""
    }
  },
  "security": {
    "allow_all": false,
    "command_timeout_ms": 30000,
    "deny": []
  }
}
