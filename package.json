{
  "name": "ppx-agent",
  "version": "1.5.0",
  "description": "皮皮虾 (PPX Agent) - 会自我修复、自我学习的超级 Agent. 零依赖纯Node智能体内核.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "chen6896qqwee <chen6896qqwee@users.noreply.github.com>",
  "engines": {
    "node": ">=20"
  },
  "main": "src/agent/index.js",
  "bin": {
    "ppx": "bin/ppx.js",
    "ppx-serve": "bin/ppx-serve.js",
    "ppx-channels": "bin/ppx-channels.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chen6896qqwee/ppx-agent.git"
  },
  "scripts": {
    "start": "node src/agent/index.js",
    "chat": "node src/cli.js",
    "serve": "node src/server.js",
    "web": "node scripts/start-web.js",
    "web:build": "npm run build --prefix web",
    "release": "node scripts/release.js",
    "eval": "node scripts/eval.js",
    "dsh": "cd .deps/deepseek-harness && pnpm dsh",
    "dsh:install": "cd .deps/deepseek-harness && pnpm install",
    "dsh:build": "cd .deps/deepseek-harness && pnpm run build",
    "selfheal": "node scripts/selfheal-bench.js",
    "selfheal:run": "node src/selfheal/run.js",
    "bench": "node scripts/bench.js",
    "test": "node --test --test-force-exit test/*.test.js",
    "prepublishOnly": "npm run selfheal && npm test"
  },
  "keywords": [
    "agent",
    "ai",
    "llm",
    "memory",
    "autonomous",
    "self-healing",
    "zero-dependency"
  ],
  "files": [
    "bin/",
    "src/",
    "config/",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/agent/index.js",
    "./server": "./src/server.js",
    "./cli": "./src/cli.js"
  }
}
